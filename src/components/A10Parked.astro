---
import { a10Svg } from '../lib/a10sprite';
const svg = a10Svg({ gear: true, scale: 2 });
---
<button type="button" class="a10-parked group" data-a10-launch data-a10-parked aria-label="An A-10 parked on the ramp. Press to launch it.">
  <span class="a10-tag" aria-hidden="true">REMOVE BEFORE FLIGHT</span>
  <span class="block" set:html={svg} />
</button>
<style>
  .a10-parked {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 6px;
    border-radius: 8px;
    cursor: pointer;
    transform: rotate(-3deg);
    transition: transform 0.2s, opacity 0.3s;
    opacity: 0.9;
  }
  .a10-parked:hover { transform: rotate(0deg) translateY(-2px); opacity: 1; }
  .a10-parked[data-away='true'] { opacity: 0; transform: translateX(30px); }
  .a10-tag {
    font-family: var(--font-pixel);
    font-size: 6px;
    line-height: 1;
    color: #fff;
    background: #c8352b;
    padding: 3px 4px;
    margin-bottom: 2px;
    margin-right: 2px;
    transform: rotate(4deg);
    transform-origin: right top;
    animation: flutter 2.4s ease-in-out infinite;
  }
  @keyframes flutter { 50% { transform: rotate(9deg); } }
</style>
