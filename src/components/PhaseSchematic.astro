---
// Illustrative only: what "converged but discontinuous" looks like versus explicit phase linkage. Not Turion data.
// stacked: one panel above the other (the homepage side panel), with larger labels
interface Props { note?: boolean; stacked?: boolean }
const { note = true, stacked = false } = Astro.props;
const fs = stacked ? 1.25 : 1;
const phases = [
  { d: 'M20 150 C 70 140, 110 110, 150 100', c: '#26a596' },
  { d: 'M150 100 C 190 90, 230 60, 270 64', c: '#9a7ae6' },
  { d: 'M270 64 C 310 68, 340 50, 380 40', c: '#26a596' },
];
const broken = [
  { d: 'M20 150 C 70 140, 110 110, 150 100', c: '#26a596' },
  { d: 'M150 84 C 190 74, 230 48, 270 52', c: '#9a7ae6' },
  { d: 'M270 76 C 310 80, 340 56, 380 40', c: '#26a596' },
];
---
<div class:list={['grid', stacked ? 'gap-3' : 'gap-4 sm:grid-cols-2']}>
  {[{ t: 'Before: solver reports convergence', p: broken, gaps: true }, { t: 'After: full-state linkage at every boundary', p: phases, gaps: false }].map((v) => (
    <div class="rounded-lg border border-line bg-void/60 p-3">
      <p class:list={['mb-2 font-semibold text-ink-2', stacked ? 'text-sm' : 'text-xs']}>{v.t}</p>
      <svg viewBox={stacked ? "0 30 400 145" : "0 0 400 170"} class="h-auto w-full" role="img" aria-label={v.gaps ? 'Three trajectory phases whose endpoints do not meet at the boundaries' : 'Three trajectory phases joined continuously at the boundaries'}>
        <g stroke="#262357" stroke-width="1">
          {[40, 80, 120, 160].map((y) => <line x1="0" x2="400" y1={y} y2={y} />)}
        </g>
        {v.p.map((ph) => <path d={ph.d} stroke={ph.c} stroke-width="3" fill="none" stroke-linecap="round" />)}
        {v.gaps ? (
          <g>
            <line x1="150" y1="100" x2="150" y2="84" stroke="#ff7a2f" stroke-width="2" stroke-dasharray="3 3" />
            <line x1="270" y1="52" x2="270" y2="76" stroke="#ff7a2f" stroke-width="2" stroke-dasharray="3 3" />
            <circle cx="150" cy="92" r="11" fill="none" stroke="#ff7a2f" stroke-width="1.5" />
            <circle cx="270" cy="64" r="15" fill="none" stroke="#ff7a2f" stroke-width="1.5" />
            <text x="160" y="125" fill="#ffb27a" font-size={12 * fs} font-family="monospace">state jump</text>
          </g>
        ) : (
          <g>
            <circle cx="150" cy="100" r="5" fill="#5fd39a" />
            <circle cx="270" cy="64" r="5" fill="#5fd39a" />
            <text x="160" y="125" fill="#5fd39a" font-size={12 * fs} font-family="monospace">x⁻ = x⁺ (same frame)</text>
          </g>
        )}
        <text x="20" y="166" fill="#8f9ab2" font-size={11 * fs} font-family="monospace">phase 1</text>
        <text x="190" y="166" fill="#8f9ab2" font-size={11 * fs} font-family="monospace">phase 2</text>
        <text x="320" y="166" fill="#8f9ab2" font-size={11 * fs} font-family="monospace">phase N</text>
      </svg>
    </div>
  ))}
</div>
{note && <p class="mt-2 text-xs text-muted">Schematic for illustration. Not Turion data.</p>}
