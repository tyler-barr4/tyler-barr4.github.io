---
// Layered block diagram built from HTML so it reflows on phones (rows become columns).
export interface Stage { title: string; detail?: string; tone?: 'auth' | 'ai' | 'human' | 'plain' }
export interface Layer { label: string; stages: Stage[]; loop?: string; down?: string }
interface Props { layers: Layer[]; legend?: boolean }
const { layers, legend = false } = Astro.props;
const tone = {
  auth: 'border-c1/70 bg-c1/10',
  ai: 'border-c3/70 bg-c3/10',
  human: 'border-good/60 bg-good/10',
  plain: 'border-line-2 bg-panel',
};
---
<div class="arch">
  {legend && (
    <ul class="mb-4 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-2">
      <li class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-[3px] border border-c1/70 bg-c1/10" aria-hidden="true"></span>Holds authority (physics, sources, solver)</li>
      <li class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-[3px] border border-c3/70 bg-c3/10" aria-hidden="true"></span>Learned or adaptive component</li>
      <li class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-[3px] border border-good/60 bg-good/10" aria-hidden="true"></span>Human decision</li>
    </ul>
  )}
  <ol class="space-y-2">
    {layers.map((l, li) => (
      <li>
        <p class="label mb-2">{l.label}</p>
        <ol class="flex flex-col gap-2 md:flex-row md:items-stretch">
          {l.stages.map((s, i) => (
            <>
              <li class:list={['flex-1 rounded-lg border px-3 py-2.5', tone[s.tone ?? 'plain']]}>
                <p class="text-sm font-semibold leading-snug text-ink">{s.title}</p>
                {s.detail && <p class="mt-1 text-xs leading-snug text-ink-2">{s.detail}</p>}
              </li>
              {i < l.stages.length - 1 && (
                <li aria-hidden="true" class="flex items-center justify-center text-muted">
                  <svg width="18" height="18" viewBox="0 0 18 18" class="rotate-90 md:rotate-0"><path d="M2 9h13m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
                </li>
              )}
            </>
          ))}
        </ol>
        {l.loop && <p class="mt-2 flex items-center gap-2 font-mono text-xs text-signal"><span aria-hidden="true">↺</span>{l.loop}</p>}
        {l.down && li < layers.length - 1 && (
          <p class="my-2 flex items-center gap-2 pl-2 font-mono text-xs text-accent-2"><span aria-hidden="true">↓</span>{l.down}</p>
        )}
      </li>
    ))}
  </ol>
</div>
