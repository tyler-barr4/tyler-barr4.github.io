---
// One 100% bar split into outcome segments, with a legend that also carries the values.
interface Seg { label: string; value: number; color: 'c0' | 'c1' | 'c2' | 'c3' }
interface Props { segs: Seg[]; total: number; unit?: string }
const { segs, total } = Astro.props;
const cls = { c0: 'bg-c0', c1: 'bg-c1', c2: 'bg-c2', c3: 'bg-c3' };
---
<div>
  <div class="flex h-10 w-full gap-[2px] overflow-hidden rounded-[4px]">
    {segs.map((s) => (
      <span tabindex="0" role="img" aria-label={`${s.label}: ${s.value} of ${total}`} data-tip={`${s.label}: ${s.value} of ${total} (${((s.value / total) * 100).toFixed(1)}%)`} class:list={['h-full', cls[s.color]]} style={`width:${(s.value / total) * 100}%; min-width:3px`}></span>
    ))}
  </div>
  <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    {segs.map((s) => (
      <li class="flex items-center gap-2">
        <span class:list={['inline-block h-3 w-3 rounded-[3px]', cls[s.color]]} aria-hidden="true"></span>
        <span class="text-ink-2">{s.label}</span>
        <span class="font-mono tabular-nums text-ink">{s.value} <span class="text-muted">({((s.value / total) * 100).toFixed(1)}%)</span></span>
      </li>
    ))}
  </ul>
</div>
