---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Signal lost · Tyler Barr" description="This page does not exist." noindex starfield>
  <section class="mx-auto flex min-h-[80vh] max-w-3xl flex-col justify-center px-4 pt-24 sm:px-6">
    <p class="label">Error 404 · Loss of signal</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">This page drifted out of range.</h1>
    <p class="mt-4 text-lg text-ink-2">The link may be old or mistyped. Everything on the site starts from the homepage.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={url('/')}>Back to the homepage</a>
      <a class="btn" href={url('/#research')}>See the research</a>
    </div>
  </section>
</Base>
