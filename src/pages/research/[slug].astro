---
import Base from '../../layouts/Base.astro';
import CaseArchitecture from '../../components/CaseArchitecture.astro';
import CaseFigures from '../../components/CaseFigures.astro';
import { caseStudies, publications, type CaseStudy } from '../../data/site';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return caseStudies.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, prev: caseStudies[(i - 1 + caseStudies.length) % caseStudies.length], next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}
interface Props { c: CaseStudy; prev: CaseStudy; next: CaseStudy }
const { c, prev, next } = Astro.props;
const hasGame = c.slug === 'adaptive-rendezvous';
// the papers behind this project, newest first as listed in publications
const pubs = publications.filter((p) => p.topic === c.slug);
const boldMe = (s: string) => s.replace('T. Barr', '<strong class="text-ink font-semibold">T. Barr</strong>');
const readLabel = (l?: string) => (l === 'ResearchGate' ? 'Find it on ResearchGate' : l === 'arXiv' ? 'Read the preprint on arXiv' : 'Read the paper');
const toc = [
  { id: 'problem', n: '01', t: 'Problem & constraints' },
  { id: 'architecture', n: '02', t: 'System architecture' },
  { id: 'tradeoffs', n: '03', t: 'Key trade-offs' },
  { id: 'outcomes', n: '04', t: 'Measured outcomes' },
  ...(hasGame ? [{ id: 'try-it', n: '05', t: 'Try it: docking game' }] : []),
  { id: 'papers', n: hasGame ? '06' : '05', t: 'Read the papers' },
];
const idx = caseStudies.findIndex((x) => x.slug === c.slug);
const chapterName = `Research ${idx + 1} of ${caseStudies.length} · ${c.chapter.step}`;
---
<Base title={`${c.title} · Tyler Barr`} description={c.short} path={`/research/${c.slug}/`} starfield>
  <article class="mx-auto max-w-7xl px-4 pb-24 pt-28 sm:px-6">
    <div class="flex flex-wrap gap-2.5">
      <a href={url(`/#${c.slug}`)} class="btn"><span aria-hidden="true">←</span> Back to the research overview</a>
      {pubs.length > 0 && <a href="#papers" class="btn">Jump to the {pubs.length === 1 ? 'paper' : 'papers'} <span aria-hidden="true">↓</span></a>}
    </div>

    <header class="mt-6 max-w-3xl">
      <p class="label">{chapterName}</p>
      <h1 class="display mt-3 text-4xl sm:text-6xl">{c.title}</h1>
      <p class="mt-4 text-xl leading-relaxed text-ink-2">{c.short}</p>
      <dl class="mt-6 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-3">
        <div><dt class="label">When</dt><dd class="mt-1 text-ink">{c.when}</dd></div>
        <div><dt class="label">Where</dt><dd class="mt-1 text-ink">{c.where}</dd></div>
        <div><dt class="label">My role</dt><dd class="mt-1 text-ink">{c.role}</dd></div>
      </dl>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Methods">{c.tags.map((t) => <li class="chip">{t}</li>)}</ul>
      {c.note && <p class="mt-6 rounded-lg border border-line-2 bg-panel/70 px-4 py-3 text-sm text-ink-2">{c.note}</p>}
    </header>

    <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-4">
      {c.stats.map((s) => (
        <div class="bg-deep/95 p-5">
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="block font-mono text-2xl font-semibold tracking-tight text-accent-2 sm:text-3xl">{s.value}</span>
            <span class="mt-1 block text-sm text-muted" aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-14 grid gap-12 lg:grid-cols-[13rem_1fr]">
      <nav aria-label="On this page" class="hidden lg:block">
        <ol class="sticky top-24 space-y-2 border-l border-line-2 pl-4 font-mono text-xs uppercase tracking-[0.12em]">
          {toc.map((x) => <li><a class="text-muted no-underline hover:text-ink" href={`#${x.id}`}><span class="text-accent">{x.n}</span> {x.t}</a></li>)}
        </ol>
      </nav>

      <div class="min-w-0 space-y-16">
        <section id="problem" class="scroll-mt-24" aria-labelledby="h-problem">
          <h2 id="h-problem" class="flex items-baseline gap-3 text-2xl font-extrabold uppercase tracking-wide sm:text-3xl"><span class="font-mono text-base text-accent">01</span>Problem &amp; constraints</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-2">{c.problem.summary}</p>
          <blockquote class="mt-6 max-w-3xl border-l-2 border-accent pl-5 text-lg font-medium leading-relaxed text-ink">
            <span class="label mb-1 block !text-accent-2">Question</span>
            {c.problem.question}
          </blockquote>
          <h3 class="label mt-8">Constraints</h3>
          <ul class="mt-3 grid max-w-4xl gap-3 sm:grid-cols-2">
            {c.problem.constraints.map((k) => <li class="panel p-4 text-ink-2">{k}</li>)}
          </ul>
        </section>

        <section id="architecture" class="scroll-mt-24" aria-labelledby="h-arch">
          <h2 id="h-arch" class="flex items-baseline gap-3 text-2xl font-extrabold uppercase tracking-wide sm:text-3xl"><span class="font-mono text-base text-accent">02</span>System architecture</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-2">{c.architecture.summary}</p>
          <div class="panel mt-6 p-4 sm:p-6"><CaseArchitecture slug={c.slug} /></div>
          <ul class="mt-6 max-w-3xl list-disc space-y-2 pl-5 text-ink-2 marker:text-accent">
            {c.architecture.points.map((p) => <li>{p}</li>)}
          </ul>
        </section>

        <section id="tradeoffs" class="scroll-mt-24" aria-labelledby="h-trade">
          <h2 id="h-trade" class="flex items-baseline gap-3 text-2xl font-extrabold uppercase tracking-wide sm:text-3xl"><span class="font-mono text-base text-accent">03</span>Key engineering trade-offs</h2>
          <ol class="mt-6 grid gap-4 xl:grid-cols-2">
            {c.tradeoffs.map((t) => (
              <li class="panel flex flex-col p-5">
                <p class="text-sm text-muted">Chose</p>
                <p class="font-semibold text-ink">{t.chose}</p>
                <p class="mt-2 text-sm text-muted">over <span class="text-ink-2">{t.over}</span></p>
                <div class="mt-4 grid gap-3 border-t border-line pt-4 text-sm sm:grid-cols-2">
                  <div><p class="label !text-good">Why</p><p class="mt-1 text-ink-2">{t.why}</p></div>
                  <div><p class="label !text-accent-2">Cost</p><p class="mt-1 text-ink-2">{t.cost}</p></div>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section id="outcomes" class="scroll-mt-24" aria-labelledby="h-out">
          <h2 id="h-out" class="flex items-baseline gap-3 text-2xl font-extrabold uppercase tracking-wide sm:text-3xl"><span class="font-mono text-base text-accent">04</span>Measured outcomes</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-2">{c.outcomes.summary}</p>
          <div class="mt-6"><CaseFigures slug={c.slug} /></div>
          <ul class="mt-6 max-w-3xl list-disc space-y-2 pl-5 text-ink-2 marker:text-accent">
            {c.outcomes.points.map((p) => <li>{p}</li>)}
          </ul>
          {c.outcomes.caveat && (
            <p class="mt-6 max-w-3xl rounded-lg border border-line-2 bg-panel/70 px-4 py-3 text-sm text-ink-2"><span class="font-semibold text-ink">Limits.</span> {c.outcomes.caveat}</p>
          )}
        </section>

        {hasGame && (
          <section id="try-it" class="scroll-mt-24" aria-labelledby="h-try">
            <h2 id="h-try" class="flex items-baseline gap-3 text-2xl font-extrabold uppercase tracking-wide sm:text-3xl"><span class="font-mono text-base text-accent">05</span>Try it: dock by hand</h2>
            <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-2">
              The homepage’s 8-bit docking game runs on the same Clohessy–Wiltshire model the controller predicts with.
              Fly it yourself, then compare your delta-v with the autopilot’s.
            </p>
            <a class="btn btn-primary mt-6" href={url('/#adaptive-rendezvous')}>Play the docking game</a>
          </section>
        )}

        <section id="papers" class="scroll-mt-24" aria-labelledby="h-papers">
          <h2 id="h-papers" class="flex items-baseline gap-3 text-2xl font-extrabold uppercase tracking-wide sm:text-3xl"><span class="font-mono text-base text-accent">{hasGame ? '06' : '05'}</span>Read the papers</h2>
          {pubs.length > 0 ? (
            <ol class="mt-6 grid gap-4 xl:grid-cols-2">
              {pubs.map((p) => (
                <li class="panel flex flex-col p-5">
                  <p class="font-mono text-xs text-muted">{p.year} · {p.status}</p>
                  <h3 class="mt-1 text-lg font-semibold leading-snug text-ink">{p.title}</h3>
                  <p class="mt-1 text-sm text-ink-2"><span set:html={boldMe(p.authors)} /></p>
                  <p class="mt-0.5 text-sm italic text-muted">{p.venue}</p>
                  {p.href && (
                    <div class="mt-auto pt-4">
                      <a class="btn btn-primary" href={p.href} target="_blank" rel="noopener">{readLabel(p.linkLabel)}<span class="sr-only">: {p.title} (opens in new tab)</span> <span aria-hidden="true">↗</span></a>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          ) : (
            <p class="mt-4 max-w-3xl text-lg text-ink-2">This was internship work at Turion Space, so there is no public paper or code.</p>
          )}
          {(c.papers.length > 0 || c.code) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {c.papers.map((p) => p.href
                ? <a class="btn" href={p.href} target="_blank" rel="noopener">{p.label} <span aria-hidden="true">↗</span></a>
                : <span class="btn cursor-default">{p.label} <span class="text-xs text-muted">(not yet online)</span></span>)}
              {c.code?.map((k) => k.status === 'live' && k.href
                ? <a class="btn" href={k.href} target="_blank" rel="noopener">Code: {k.label} ↗</a>
                : <span class="btn btn-soon">Code: {k.label} <span class="chip !border-accent/50 !text-accent-2">public release soon</span></span>)}
            </div>
          )}
        </section>
      </div>
    </div>

    <nav aria-label="More case studies" class="mt-20 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      <a href={url(`/research/${prev.slug}/`)} class="panel block p-5 no-underline hover:border-line-2"><span class="label">← Previous</span><span class="mt-1 block text-lg font-semibold">{prev.title}</span></a>
      <a href={url(`/research/${next.slug}/`)} class="panel block p-5 text-right no-underline hover:border-line-2"><span class="label">Next →</span><span class="mt-1 block text-lg font-semibold">{next.title}</span></a>
    </nav>
  </article>
</Base>
